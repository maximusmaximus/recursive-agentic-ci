# =====================================================================
# Recursive Agentic CI - Environment Variables
# =====================================================================

# Venice AI Privacy-Preserving API Configuration
VENICE_API_KEY=your_venice_api_key_here
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_MODEL=llama-3.3-70b
VENICE_PLANNING_MODEL=deepseek-r1

# Telegram HITL Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=8293122782

# Server & Dashboard Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=18880
SERVER_SECRET_KEY=change_me_to_a_secure_random_string

# MCP (Model Context Protocol) Server
MCP_HOST=0.0.0.0
MCP_PORT=18881
MCP_SECRET_TOKEN=mcp_secret_token_here

# Governance & Anti-Abuse Hard Caps
DAILY_TOKEN_BUDGET=250000
DAILY_PR_LIMIT=5
MIN_DELAY_HOURS=24
SANDBOX_TIMEOUT_SECONDS=180

# State Database Path
DATABASE_PATH=data/recursive_ci.db
